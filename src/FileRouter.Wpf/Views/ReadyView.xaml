<UserControl x:Class="FileRouter.Wpf.Views.ReadyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- monitored folders: grid of cards at the top (Python parity) -->
        <StackPanel Visibility="{Binding DashboardVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding MonitorTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- a grid card per folder; a real Button, so it's
                             keyboard-focusable and screen-reader-named -->
                        <Button Command="{Binding OpenCommand}"
                                Background="{Binding Back, Converter={StaticResource RgbToBrush}}"
                                Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}"
                                AutomationProperties.Name="{Binding Display}"
                                ToolTip="{Binding Tooltip}"
                                MinHeight="78" Margin="0,0,6,6" Padding="12,8"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top"
                                BorderThickness="0" Cursor="Hand">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                <TextBlock Text="{Binding CountText}" FontSize="27" FontWeight="Bold"
                                           Margin="0,2,0,0"
                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                                <!-- where the alerting file sits, when it's in
                                     a subfolder of the watched folder -->
                                <TextBlock Text="{Binding SubfolderNote}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding HasSubfolderNote,
                                                        Converter={StaticResource BoolToVis}}"
                                           Foreground="{Binding Fore, Converter={StaticResource RgbToBrush}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- separation between the monitored folders and the inbox block -->
            <Rectangle Height="1" Fill="{DynamicResource Theme.Border}" Margin="0,14,0,0" />
        </StackPanel>

        <!-- the inbox: one big number over the Start button. A real button —
             clicking it opens the inbox folder (keyboard/screen-reader too) -->
        <Button Command="{Binding OpenInboxCommand}"
                HorizontalAlignment="Center" Margin="0,14,0,0"
                Cursor="Hand" ToolTip="Open the inbox folder"
                AutomationProperties.Name="{Binding CountLine}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent"
                            CornerRadius="6" Padding="18,0,18,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="{DynamicResource Theme.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel>
                <TextBlock Text="{Binding BigCount}" FontSize="76" FontWeight="Bold"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CountAlertOn}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding CountCaption}" Style="{StaticResource SubtleText}"
                           HorizontalAlignment="Center" Margin="0,-6,0,0" />
            </StackPanel>
        </Button>
        <TextBlock Text="{Binding DetailLine}" Style="{StaticResource SubtleText}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,4,0,0" />

        <Button Content="Start Processing" Command="{Binding StartCommand}"
                Style="{StaticResource PrimaryButton}" Height="48" Margin="0,14,0,0"
                FontSize="15" />
    </StackPanel>
</UserControl>
