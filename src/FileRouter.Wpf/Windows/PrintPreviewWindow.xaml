<Window x:Class="FileRouter.Wpf.Windows.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileRouter.Wpf.Windows"
        Title="FileRouter — Print preview" Width="900" Height="840"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Width="96" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Print…" Click="OnPrint"
                    Style="{StaticResource PrimaryButton}" Width="110" Margin="0,0,8,0" />
            <TextBlock x:Name="PageInfo" VerticalAlignment="Center"
                       Style="{StaticResource SubtleText}" />
        </DockPanel>

        <!-- the exact document that spools: zoom and page through it here -->
        <local:PreviewDocumentViewer x:Name="Viewer" />
    </DockPanel>
</Window>
